{
  "name": "gozar-console",
  "version": "0.1.0",
  "private": true,
  "description": "Gozar Web_Console: React + TypeScript (strict) admin SPA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
