# Gozar Console build-time configuration. Copy to `.env` for local use.
# Vite only exposes variables prefixed with VITE_ to client code.

# Origin of the Gozar backend API. Leave empty for same-origin (a reverse proxy
# serves the SPA and forwards /api and /v1 to the backend). In `docker compose`
# dev this is set to the published backend port.
VITE_API_BASE_URL=http://localhost:8000

# Backend origin the Vite dev server proxies /api and /v1 to during `npm run dev`.
# Only used in development; ignored in production builds.
VITE_DEV_PROXY_TARGET=http://localhost:8000
