# --- Secrets / environment (NEVER commit real values) ---
.env
.env.*
*.env
!.env.example

# --- Local Kiro workspace (may contain private instructions or secrets) ---
.kiro/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/
frontend/.eslintcache
*.tsbuildinfo

# --- Playwright (frontend e2e) artifacts ---
test-results/
playwright-report/
blob-report/
.playwright-mcp/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/.last-run.json

# --- Local databases / generated runtime state ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- TLS / certificates / keys (should never be in the repo) ---
*.pem
*.key
*.crt
*.csr
certs/
secrets/
deploy/nginx/ssl/

# --- Private deployment overrides ---
deploy/nginx/*-private.conf
deploy/nginx/*.local.conf
deploy/nginx/*.local.sh

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
